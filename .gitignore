# macOS and local scratch files
.DS_Store
.fake
._*

# Dependencies and Python caches
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Generated builds, screenshots, reports, logs and playtest packages
/outputs/
*.log
/test-results/
/playwright-report/
/blob-report/
/coverage/

# Captures belong in outputs/, including captures made outside test runners.
**/[Ss]creenshots/
**/screen-captures/
**/recordings/
*[Ss]creenshot*.png
*[Ss]creenshot*.jpg
*[Ss]creenshot*.jpeg
*[Ss]creenshot*.webp
Screen Shot *.png
*[Ss]creen*[Rr]ecord*.mov
*[Ss]creen*[Rr]ecord*.mp4
*[Ss]creen*[Rr]ecord*.webm
**/test-results/
**/playwright-report/
**/blob-report/

# This historical capture is also preserved inside the original playtest ZIP.
/initalDemoDocs/Exception_Human_V3_forecast.png

# Deliberately curated Play Store evidence is the capture exception.
# Keep this after capture rules; native app icons/splashes are source assets.
!/release/play-store/evidence/**/
!/release/play-store/evidence/**/*.png
!/release/play-store/evidence/**/*.jpg
!/release/play-store/evidence/**/*.jpeg
!/release/play-store/evidence/**/*.webp

# Capacitor assets and downloaded native toolchains
/apps/native/www/
/apps/native/.cache/
/apps/native/ios/App/App/public/
/apps/native/android/app/src/main/assets/public/

# Android machine configuration and build caches
/apps/native/android/local.properties
/apps/native/android/.gradle/
/apps/native/android/.kotlin/
/apps/native/android/**/build/

# Xcode / Swift local state and build products
/apps/native/ios/App/build/
/apps/native/ios/App/CapApp-SPM/.build/
/apps/native/ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
*.xcuserstate
xcuserdata/
*.xcresult/
*.dSYM/
*.apk
*.aab
*.ipa

# Local environment and signing credentials
.env
.env.*
*.keystore
*.jks
*.p12
*.mobileprovision

# Reproducible mobile bundle; regenerate with python3 tools/build-mobile.py.
/mobile/index.html

# One-off layout diagnosis, retained locally rather than as a source asset.
/thermal-layout-debug.png

# Native archives and downloaded/build caches, regardless of output location.
*.xcarchive/
DerivedData/
SourcePackages/
.swiftpm/
*.xcframework/

# Apple signing and API private keys (public ad/team identifiers are not secrets).
*.p8
*.key
